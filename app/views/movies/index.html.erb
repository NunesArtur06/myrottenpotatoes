<h1>Todos os Filmes</h1>

<%= link_to 'Adicionar Filme', new_movie_path, :class => 'btn btn-primary' %>

<div id="movies" class="mt-4">
  <div class="row font-weight-bold border-bottom pb-2">
    <div class="col-6">Título do Filme</div>
    <div class="col-3">Classificação</div>
    <div class="col-3">Data de Lançamento</div>
  </div>
  <% @movies.each do |movie| %>
    <div class="row py-2 border-bottom">
      <div class="col-6"><%= link_to movie.title, movie_path(movie) %></div>
      <div class="col-3"><%= movie.rating %></div>
      <div class="col-3"><%= movie.release_date.strftime('%d/%m/%Y') if movie.release_date %></div>
    </div>
  <% end %>
</div>