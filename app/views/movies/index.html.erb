<h1>Todos os Filmes</h1>

<%= link_to 'Adicionar Filme', new_movie_path, :class => 'btn btn-primary' %>

<table class="table table-striped col-md-12 mt-4" id="movies">
  <thead>
    <tr>
      <%# Link para Título com id 'title_header' e destaque CSS 'hilite' %>
      <th class="<%= 'hilite' if @sort_by == 'title' %>">
        <%= link_to 'Título do Filme', movies_path(:sort_by => 'title'), :id => 'title_header' %>
      </th>
      
      <th>Classificação</th>
      
      <%# Link para Data com id 'release_date_header' e destaque CSS 'hilite' %>
      <th class="<%= 'hilite' if @sort_by == 'release_date' %>">
        <%= link_to 'Data de Lançamento', movies_path(:sort_by => 'release_date'), :id => 'release_date_header' %>
      </th>
      
      <th>Mais Informações</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date.strftime('%d/%m/%Y') if movie.release_date %></td>
        <td><%= link_to "Mais sobre #{movie.title}", movie_path(movie) %></td>
      </tr>
    <% end %>
  </tbody>
</table>